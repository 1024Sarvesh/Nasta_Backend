generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}


model User{
    id Int @id @default(autoincrement())
    email String @unique
    name String 
    password String
    address String?
    otp String?
    otpcreatedAt DateTime?
    menu    Menu[]
}


model Menu{
    id Int @id @default(autoincrement())
    name String @unique
    description String?
    Price_half Int
    Price_full Int
    thumbnail String
    user User @relation(fields:[created_by], references: [id])
    created_by Int 
    created_at DateTime @default(now())
    
}

