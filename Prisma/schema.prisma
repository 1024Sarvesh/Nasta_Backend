generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}


model User{
    id Int @id @default(autoincrement())
    email String @unique
    name String 
    password String
    address String?
    otp String?
}

// migration - jab bhi schema me koi changes hoga to migration run karke database me changes karta hai or table modification.
// server ko database se link karne ke liye - prisma client.